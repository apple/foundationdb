Subject: [PATCH] abseil: optional replacement source of seed material

Lets deterministic simulation seed every absl random generator, while leaving
the OS as the source everywhere else.

--- a/third_party/abseil-cpp/absl/random/internal/seed_material.cc
+++ b/third_party/abseil-cpp/absl/random/internal/seed_material.cc
@@ -23,6 +23,7 @@
 #endif
 
 #include <algorithm>
+#include <atomic>
 #include <cassert>
 #include <cerrno>
 #include <cstdint>
@@ -209,8 +210,14 @@
 
 #endif
 
+std::atomic<SeedMaterialSource> seed_material_source{nullptr};
+
 }  // namespace
 
+void SetSeedMaterialSource(SeedMaterialSource source) {
+  seed_material_source.store(source, std::memory_order_release);
+}
+
 bool ReadSeedMaterialFromOSEntropy(absl::Span<uint32_t> values) {
   assert(values.data() != nullptr);
   if (values.data() == nullptr) {
@@ -219,6 +226,10 @@
   if (values.empty()) {
     return true;
   }
+  if (SeedMaterialSource source =
+          seed_material_source.load(std::memory_order_acquire)) {
+    return source(values);
+  }
   return ReadSeedMaterialFromOSEntropyImpl(values);
 }
 
--- a/third_party/abseil-cpp/absl/random/internal/seed_material.h
+++ b/third_party/abseil-cpp/absl/random/internal/seed_material.h
@@ -57,6 +57,12 @@
 [[nodiscard]]
 bool ReadSeedMaterialFromOSEntropy(absl::Span<uint32_t> values);
 
+// When set, `source` replaces the OS as the supplier of all seed material, so
+// that a deterministic simulation can reproduce every generator it seeds.
+// Passing nullptr restores the OS.
+using SeedMaterialSource = bool (*)(absl::Span<uint32_t> values);
+void SetSeedMaterialSource(SeedMaterialSource source);
+
 // Attempts to fill a span of uint32_t-values using variates generated by an
 // existing instance of a class conforming to the C++ Standard "Uniform Random
 // Bit Generator" concept [rand.req.urng]. The resulting data may be used to
