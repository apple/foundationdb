@@ -0,0 +1,51 @@
+// FDB simulation patch: a set that iterates in insertion order, for containers whose iteration order is observable
+// (e.g. the order queued calls are released). absl::flat_hash_set iterates in an order that depends on the hash seed
+// and, for pointer keys, on heap addresses, which makes gRPC's behaviour differ between otherwise identical runs.
+
+#ifndef GRPC_SRC_CORE_UTIL_INSERTION_ORDERED_SET_H
+#define GRPC_SRC_CORE_UTIL_INSERTION_ORDERED_SET_H
+
+#include <functional>
+#include <list>
+#include <utility>
+
+#include "absl/container/flat_hash_map.h"
+#include "absl/hash/hash.h"
+
+namespace grpc_core {
+
+template <typename T, typename Hash = absl::Hash<T>, typename Eq = std::equal_to<T>>
+class InsertionOrderedSet {
+ public:
+  using iterator = typename std::list<T>::iterator;
+
+  bool insert(T value) {
+    if (index_.contains(value)) return false;
+    auto it = items_.insert(items_.end(), std::move(value));
+    index_.emplace(*it, it);
+    return true;
+  }
+  size_t erase(const T& value) {
+    auto found = index_.find(value);
+    if (found == index_.end()) return 0;
+    items_.erase(found->second);
+    index_.erase(found);
+    return 1;
+  }
+  void clear() {
+    index_.clear();
+    items_.clear();
+  }
+  bool empty() const { return items_.empty(); }
+  size_t size() const { return items_.size(); }
+  iterator begin() { return items_.begin(); }
+  iterator end() { return items_.end(); }
+
+ private:
+  std::list<T> items_;
+  absl::flat_hash_map<T, iterator, Hash, Eq> index_;
+};
+
+}  // namespace grpc_core
+
+#endif  // GRPC_SRC_CORE_UTIL_INSERTION_ORDERED_SET_H
